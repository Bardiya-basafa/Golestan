@model UpdateFacultyDto

@{
        ViewData["title"] = "Edit Faculty Information";
}


<!-- Main Content -->
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                <div class="px-8 py-6 border-b border-blue-500">
                        <div class="flex justify-between items-center">
                                <div>
                                        <p class="text-3xl font-bold text-white mb-2">Edit Faculty</p>
                                        <p class="text-blue-100 text-lg">Update faculty member information</p>
                                        <div class="mt-2 text-sm text-blue-200">
                                                <i class="fas fa-hashtag mr-1"></i>Faculty ID: @Model.Id
                                        </div>
                                </div>
                                <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center shadow-md">
                                        <i class="fas fa-edit text-blue-600 text-3xl"></i>
                                </div>
                        </div>
                </div>
        </div>

        <!-- Validation Summary -->
        @if (!ViewData.ModelState.IsValid){
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8 animate-fade-in">
                        <div class="flex items-start">
                                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                                        <i class="fas fa-exclamation-triangle text-white text-sm"></i>
                                </div>
                                <div>
                                        <h3 class="text-lg font-semibold text-blue-800 mb-2">Please correct the following errors:</h3>
                                        <div asp-validation-summary="All" class="text-blue-700 text-sm"></div>
                                </div>
                        </div>
                </div>
        }
        <!-- Form -->
        <div class="bg-white rounded-lg p-8 shadow-sm border border-blue-200 animate-slide-up">
                <form asp-controller="Faculties" asp-action="EditFaculty" method="POST" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <!-- Hidden ID field -->
                        <input asp-for="Id" type="hidden"/>
                        <!-- Building Name -->
                        <div>
                                <label asp-for="BuildingName" class="block text-sm font-bold text-slate-700 mb-2">
                                        <i class="fas fa-building mr-2 text-blue-700"></i>Building Name *
                                </label>
                                <input
                                                type="text"
                                                asp-for="BuildingName"
                                                value="@Model.BuildingName"
                                                required
                                                maxlength="100"
                                                class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                                                placeholder="Enter building name (e.g., Science Hall)"
                                                data-val="true"
                                                data-val-required="Building name is required"
                                                data-val-remote="Building is already taken"
                                                data-val-remote-url="/Faculties/VerifyBuildingName"
                                                data-val-remote-additionalfields="*.Id"
                                >
                                <span asp-validation-for="BuildingName" class="error-message"></span>
                                <p class="text-xs text-slate-500 mt-1">Official building name where faculty is located</p>
                        </div>
                        <!-- Major Name -->
                        <div>
                                <label asp-for="MajorName" class="block text-sm font-bold text-slate-700 mb-2">
                                        <i class="fas fa-graduation-cap mr-2 text-blue-700"></i>Major Name *
                                </label>
                                <input
                                                type="text"
                                                asp-for="MajorName"
                                                value="@Model.MajorName"
                                                required
                                                maxlength="100"
                                                class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                                                placeholder="Enter major name (e.g., Computer Science)"
                                                data-val="true"
                                                data-val-required="Major name is required"
                                                data-val-remote="Major is already taken"
                                                data-val-remote-url="/Faculties/VerifyMajor"
                                                data-val-remote-additionalfields="*.Id"
                                >
                                <span asp-validation-for="MajorName" class="field-validation-error">
                </span>
                                <p class="text-xs text-slate-500 mt-1">Primary academic major or department name</p>
                        </div>
                        <!-- Budget -->
                        <div>
                                <label asp-for="Budget" class="block text-sm font-bold text-slate-700 mb-2">
                                        <i class="fas fa-dollar-sign mr-2 text-blue-700"></i>Budget Amount *
                                </label>
                                <input
                                                type="number"
                                                asp-for="Budget"
                                                value="@Model.Budget"
                                                required
                                                min="1"
                                                step="1"
                                                class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                                                placeholder="Enter budget amount (e.g., 500000)"
                                                data-val="true"
                                                data-val-required="Faculty Number is required"
                                >
                                <span asp-validation-for="Budget" class="error-message"></span>
                                <p class="text-xs text-slate-500 mt-1">Annual budget allocation for the faculty</p>
                        </div>
                        <!-- Start Date -->
                        <div>
                                <label asp-for="StartDate" class="block text-sm font-bold text-slate-700 mb-2">
                                        <i class="fas fa-calendar-alt mr-2 text-blue-700"></i>Establishment Date *
                                </label>
                                <input
                                                type="date"
                                                asp-for="StartDate"
                                                value="@Model.StartDate.ToString("yyyy-MM-dd")"
                                                required
                                                class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                                                data-val="true"
                                                data-val-required="Start date is required"
                                >
                                <span asp-validation-for="StartDate" class="error-message"></span>
                                <p class="text-xs text-slate-500 mt-1">Date when the faculty was established</p>
                        </div>
                        <!-- Form Actions -->
                        <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-blue-200">
                                <a asp-controller="Faculties" asp-action="FacultyManagement" asp-route-id="@Model.Id"
                                   class="flex-1 bg-white text-slate-700 py-4 px-6 rounded-lg hover:bg-blue-50 transition-all duration-200 font-semibold border border-blue-200 shadow-sm text-center">
                                        <i class="fas fa-times mr-2"></i>Cancel Changes
                                </a>
                                <button
                                                type="submit"
                                                class="flex-1 bg-blue-600 text-white py-4 px-6 rounded-lg hover:bg-blue-700 transition-all duration-200 font-semibold shadow-md">
                                        <i class="fas fa-save mr-2"></i>Update Faculty
                                </button>
                        </div>
                </form>
        </div>
        <!-- Current Values Display -->
        <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
                <div class="flex items-start">
                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                                <i class="fas fa-info text-white text-sm"></i>
                        </div>
                        <div>
                                <h3 class="text-lg font-semibold text-blue-800 mb-2">Current Faculty Information</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-blue-700">
                                        <div>
                                                <strong>Faculty ID:</strong> @Model.Id
                                        </div>
                                        <div>
                                                <strong>Building:</strong> @Model.BuildingName
                                        </div>
                                        <div>
                                                <strong>Major:</strong> @Model.MajorName
                                        </div>
                                        <div>
                                                <strong>Budget:</strong> $@Model.Budget
                                        </div>
                                        <div>
                                                <strong>Establishment Date:</strong> @Model.StartDate.ToString("MMMM dd, yyyy")
                                        </div>
                                        <div>
                                                <strong>Last Updated:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")
                                        </div>
                                </div>
                        </div>
                </div>
        </div>
        <!-- Form Guidelines -->
        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-6">
                <div class="flex items-start">
                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                                <i class="fas fa-lightbulb text-white text-sm"></i>
                        </div>
                        <div>
                                <h3 class="text-lg font-semibold text-blue-800 mb-2">Edit Guidelines</h3>
                                <ul class="text-blue-700 space-y-1 text-sm">
                                        <li><strong>Building Name:</strong> Must be unique across all faculties</li>
                                        <li><strong>Major Name:</strong> Must be unique and represent the primary academic focus</li>
                                        <li><strong>Budget:</strong> Enter the annual budget allocation amount</li>
                                        <li><strong>Establishment Date:</strong> The original establishment date of the faculty</li>
                                        <li><strong>Validation:</strong> System will check for duplicate names in real-time</li>
                                </ul>
                        </div>
                </div>
        </div>
        <!-- Important Notice -->
        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-6">
                <div class="flex items-start">
                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                                <i class="fas fa-history text-white text-sm"></i>
                        </div>
                        <div>
                                <h3 class="text-lg font-semibold text-blue-800 mb-2">Important Notice</h3>
                                <p class="text-blue-700 text-sm">
                                        Changes to faculty information may affect related students, instructors, courses, and classrooms.
                                        Please ensure all information is accurate before saving. The system will automatically update
                                        all related records.
                                </p>
                        </div>
                </div>
        </div>
</div>
