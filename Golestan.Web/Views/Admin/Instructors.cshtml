@model List<InstructorDto>

<div class="container mx-auto px-6 py-12">
        <!-- Enhanced Header Section -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 mb-8 overflow-hidden">
                <div class="bg-blue-700 px-8 py-6">
                        <div class="flex justify-between items-center">
                                <div>
                                        <p class="text-3xl font-bold text-white mb-2">Instructor Management System</p>
                                        <p class="text-blue-300 text-lg">Comprehensive instructor administration and oversight</p>
                                </div>
                                <a asp-controller="Instructors" asp-action="Add" class="group">
                                        <div class="bg-white hover:bg-blue-50 text-blue-700 px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md hover:shadow-lg">
                                                <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                                Add New Instructor
                                        </div>
                                </a>
                        </div>
                </div>
        </div>
        <!-- Enhanced Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Total Instructors</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Count</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Average Salary</p>
                                <p class="text-2xl font-bold text-slate-900">$@(Model.Count > 0 ? Model.Average(i => i.Salary).ToString("N0") : "0")</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Faculties</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Select(i => i.Faculty.MajorName).Distinct().Count()</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">This Year Hires</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Count(i => i.HireDate.Year == DateTime.Now.Year)</p>
                        </div>
                </div>
        </div>
        <!-- Enhanced Instructor Table -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
                <div class="px-8 py-6 border-b border-blue-300">
                        <div class="flex items-center justify-between">
                                <div>
                                        <h2 class="text-2xl font-bold text-slate-900">Instructor Directory</h2>
                                        <p class="text-slate-600 mt-1">Manage instructor profiles and assignments</p>
                                </div>
                                <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                        @Model.Count Instructors
                    </span>
                                </div>
                        </div>
                </div>
                @if (Model.Count > 0){
                        <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-blue-300">
                                        <thead class="bg-blue-50">
                                                <tr>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                Instructor Info
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                Contact
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                Faculty
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                Employment
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                Salary
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                                Management
                                                        </th>
                                                </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-blue-300">
                                                @foreach (var instructor in Model){
                                                        <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                                                                        <span class="text-white font-bold text-lg">#</span>
                                                                                </div>
                                                                                <div class="ml-4">
                                                                                        <div class="text-lg font-bold text-slate-900">@instructor.FullName</div>
                                                                                        <div class="text-sm text-slate-500">ID: #@instructor.Id</div>
                                                                                        <div class="text-xs text-slate-400">User ID: @instructor.AppUser.Id</div>
                                                                                </div>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="ml-3">
                                                                                        <div class="text-sm font-semibold text-slate-900">@instructor.AppUser.Email</div>
                                                                                </div>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                    <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                        </svg>
                                            @instructor.Faculty.MajorName
                                    </span>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="ml-3">
                                                                                        <div class="text-sm font-semibold text-slate-900">@instructor.HireDate.ToString("MMM dd, yyyy")</div>
                                                                                        <div class="text-xs text-slate-500">
                                                                                                @{
                                                                                                        var yearsEmployed = DateTime.Now.Year - instructor.HireDate.Year;
                                                                                                }
                                                                                                @yearsEmployed years employed
                                                                                        </div>
                                                                                </div>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="ml-3">
                                                                                        <div class="text-lg font-bold text-slate-900">$@instructor.Salary.ToString("N0")</div>
                                                                                        <div class="text-xs text-slate-500">Annual Salary</div>
                                                                                </div>
                                                                        </div>
                                                                </td>
                                                                <td class="py-6 px-8 whitespace-nowrap">
                                                                        <div class="flex items-center justify-center space-x-3">
                                                                                <a asp-controller="Instructors" asp-action="InstructotDetails" asp-route-id="@instructor.Id" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 font-medium"> View </a>
                                                                                <a asp-controller="Instructors" asp-action="EditInstructorDetails" asp-route-id="@instructor.Id" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-all duration-200 font-medium"> Edit </a>
                                                                                <button data-instructor-id="@instructor.Id" data-instructor-fullname="@instructor.FullName" class="remove-instructor px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-all duration-200 font-medium"> Remove</button>
                                                                        </div>
                                                                </td>
                                                        </tr>
                                                }
                                        </tbody>
                                </table>
                        </div>
                }
                else{
                        <div class="text-center py-16 border-t border-blue-200">
                                <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                                        <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                                        </svg>
                                </div>
                                <h3 class="text-xl font-semibold text-slate-900 mb-2">No Instructors Found</h3>
                                <p class="text-slate-600 mb-8 max-w-md mx-auto">Start building your faculty team by adding your first instructor to the system.</p>
                                <a asp-controller="Instructors" asp-action="Add" class="inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200">
                                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        Add First Instructor
                                </a>
                        </div>
                }
        </div>
        <!-- Enhanced Pagination -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 px-8 py-6 mt-8">
                <div class="flex items-center justify-between">
                        <div class="flex-1 flex justify-between sm:hidden">
                                <a href="#" class="relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 transition-all duration-200">Previous</a>
                                <a href="#" class="ml-3 relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 transition-all duration-200">Next</a>
                        </div>
                        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                                <div>
                                        <p class="text-sm font-medium text-slate-700">
                                                Showing <span class="font-bold text-slate-900">1</span> to
                                                <span class="font-bold text-slate-900">@Model.Count</span> of
                                                <span class="font-bold text-slate-900">@Model.Count</span> results
                                        </p>
                                </div>
                                <div>
                                        <nav class="relative z-0 inline-flex rounded-lg shadow-sm border border-blue-200 -space-x-px" aria-label="Pagination">
                                                <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-l-lg border-r border-blue-200 bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 transition-all duration-200">
                                                        <span class="sr-only">Previous</span>
                                                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                        </svg>
                                                </a>
                                                <a href="#" class="relative inline-flex items-center px-6 py-3 border-r border-blue-200 bg-blue-600 text-sm font-bold text-white transition-all duration-200">1</a>
                                                <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-r-lg bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 transition-all duration-200">
                                                        <span class="sr-only">Next</span>
                                                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                                        </svg>
                                                </a>
                                        </nav>
                                </div>
                        </div>
                </div>
        </div>
        <!-- Back Navigation -->
        <div class="mt-8 text-center">
                <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center text-slate-600 hover:text-slate-900 transition-colors group font-medium">
                        <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to Admin Dashboard
                </a>
        </div>
</div>


<!-- Remove Confirmation Modal -->
<div id="confirmRemoveInstructorModal" class="fixed z-50 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <form id="removeCourseInstructor" asp-controller="Instructors" asp-action="Remove">
                @Html.AntiForgeryToken()
                <input type="hidden" name="instructorId" id="instructorId" value=""/>
                <input type="hidden" name="facultyId" id="facultyId" value="@ViewBag.FacultyId"/>
        </form>
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <!-- Background overlay -->
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
                <!-- Modal panel -->
                <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <div class="sm:flex sm:items-start">
                                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                                                <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                                </svg>
                                        </div>
                                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                                <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                                                        Remove Classroom </h3>
                                                <div class="mt-2">
                                                        <p class="text-sm text-gray-500">
                                                                Are you sure you want to remove
                                                                <span id="instructorFullName" class="font-medium"></span> from this course?
                                                        </p>
                                                </div>
                                        </div>
                                </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                                <button type="button" id="confirmRemoveInstructorBtn" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
                                        Remove
                                </button>
                                <button type="button" id="cancelRemoveInstructorBtn" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                        Cancel
                                </button>
                        </div>
                </div>
        </div>
</div>
<script>
        // Modal functionality
        const confirmRemoveInstructorModal = document.getElementById('confirmRemoveInstructorModal');
        const confirmRemoveInstructorBtn = document.getElementById('confirmRemoveInstructorBtn');
        const cancelRemoveInstructorBtn = document.getElementById('cancelRemoveInstructorBtn');
        const instructorFullName = document.getElementById('instructorFullName');

        let currentStudentToRemove = null;

        // Function to open the modal
        function openRemoveModal(instructorId, instructorName) {
                currentStudentToRemove = instructorId;
                instructorFullName.textContent = instructorName;
                confirmRemoveInstructorModal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
        }

        // Function to close the modal
        function closeRemoveModal() {
                confirmRemoveInstructorModal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
                currentStudentToRemove = null;
        }

        // Event listeners for modal buttons
        confirmRemoveInstructorBtn.addEventListener('click', function () {
                if (currentStudentToRemove) {
                        console.log(currentStudentToRemove)
                        removeStudent(currentStudentToRemove);

                }
                closeRemoveModal();
        });

        cancelRemoveInstructorBtn.addEventListener('click', closeRemoveModal);

        // Close modal when clicking outside
        confirmRemoveInstructorModal.addEventListener('click', function (e) {
                if (e.target === confirmRemoveInstructorModal) {
                        closeRemoveModal();
                }
        });

        // Function to handle student removal
        async function removeStudent(instructorId) {
                document.getElementById('instructorId').value = instructorId;
                document.getElementById('removeCourseInstructor').submit();

        }

        // Update your existing remove button event listeners
        document.addEventListener('click', function (e) {
                if (e.target.closest('.remove-instructor')) {
                        e.preventDefault();
                        const button = e.target.closest('.remove-instructor');
                        const instructorId = button.getAttribute('data-instructor-id');
                        const instructorFullName = button.getAttribute('data-instructor-fullname');
                        console.log(instructorId, instructorFullName)
                        openRemoveModal(instructorId, instructorFullName);
                }
        });
</script>