@model List<CourseDto>
@{
        var courseId = (int)ViewBag.courseid;
}
<div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-blue-300">
                <thead class="bg-blue-50">
                        <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                        Course ID
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                        Course Name
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                        Actions
                                </th>
                        </tr>
                </thead>
                <tbody class="bg-white divide-y divide-blue-300">
                        @foreach (var prereq in Model){
                                <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                        <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                <div class="text-sm font-medium text-slate-900">@prereq.Id</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                <div class="text-sm text-slate-900">@prereq.CourseName</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                <a method="post" asp-controller="Courses" asp-action="RemovePrerequisite" asp-route-courseId="@courseId" asp-route-prerequisiteCourseId="@prereq.Id" data-prereq-id="@prereq.Id" class="remove-prerequisite px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-all duration-200 font-medium">Remove</a>
                                        </td>
                                </tr>
                        }
                </tbody>
        </table>
</div>
