@model CourseDto


<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto space-y-8">
                <!-- Header Section -->
                <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                        <div class="px-8 py-6">
                                <div class="flex items-center justify-between">
                                        <div class="flex items-center">
                                                <div class="h-16 w-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-lg mr-6">
                                                        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                                        </svg>
                                                </div>
                                                <div>
                                                        <p class="text-3xl font-bold text-white mb-2">Course Management Actions</p>
                                                        <p class="text-blue-100 text-lg">@Model.CourseName - ID: @Model.Id</p>
                                                        <p class="text-blue-200 text-sm">Faculty: @Model.Faculty.MajorName | Units: @Model.Unit</p>
                                                </div>
                                        </div>
                                        <a asp-controller="Courses" asp-action="SetExamTime" asp-route-courseId="@Model.Id" class="group">
                                                <div class="bg-white hover:bg-blue-50 text-blue-700 px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md hover:shadow-lg">
                                                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                        </svg>
                                                        Set Exam Time
                                                </div>
                                        </a>
                                        <a asp-controller="Courses" asp-action="SetInstructor" asp-route-courseId="@Model.Id" asp-route-facultyId="@Model.Faculty.Id" class="group">
                                                <div class="bg-white hover:bg-blue-50 text-blue-700 px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md hover:shadow-lg">
                                                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                        </svg>
                                                        Add new instructor
                                                </div>
                                        </a>
                                </div>
                        </div>
                </div>
                <!-- Quick Stats -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <div class="flex items-center">
                                        <div class="p-3 bg-blue-100 rounded-xl">
                                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                </svg>
                                        </div>
                                        <div class="ml-4">
                                                <p class="text-sm font-medium text-blue-800">Instructors</p>
                                                <p class="text-2xl font-bold text-slate-900">@Model.Instructors.Count</p>
                                        </div>
                                </div>
                        </div>
                        <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <div class="flex items-center">
                                        <div class="p-3 bg-blue-100 rounded-xl">
                                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                        </div>
                                        <div class="ml-4">
                                                <p class="text-sm font-medium text-blue-800">Exam Date</p>
                                                @await Component.InvokeAsync("CourseExam", Model.Id)
                                        </div>
                                </div>
                        </div>
                        <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <div class="flex items-center">
                                        <div class="p-3 bg-blue-100 rounded-xl">
                                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                                                </svg>
                                        </div>
                                        <div class="ml-4">
                                                <p class="text-sm font-medium text-blue-800">Credit Units</p>
                                                <p class="text-2xl font-bold text-slate-900">@Model.Unit</p>
                                        </div>
                                </div>
                        </div>
                        <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <div class="flex items-center">
                                        <div class="p-3 bg-blue-100 rounded-xl">
                                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                                                </svg>
                                        </div>
                                        <div class="ml-4">
                                                <p class="text-sm font-medium text-blue-800">Sections</p>
                                                <p class="text-2xl font-bold text-slate-900">@Model.Sections.Count</p>
                                        </div>
                                </div>
                        </div>
                </div>
                <!-- Main Actions Grid (Top Row) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Instructor Assignment Section -->
                        <div class="bg-white rounded-lg shadow-sm border border-blue-200 overflow-hidden">
                                <div class="bg-blue-600 px-8 py-6">
                                        <h3 class="text-xl font-semibold text-white flex items-center">
                                                <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                </svg>
                                                Instructor Management
                                        </h3>
                                        <p class="text-blue-100 mt-1">Assign or change instructors for course sections</p>
                                </div>
                                <div class="p-8 space-y-6">
                                        <!-- Current Instructors -->
                                        <div class="space-y-4">
                                                <h4 class="text-lg font-semibold text-slate-900 border-l-4 border-blue-500 pl-4">Current Instructors</h4>
                                                <a asp-controller="Courses" asp-action="SetInstructor" asp-route-facultyId="@Model.Faculty.Id" asp-route-courseId="@Model.Id" class="group inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all duration-200 shadow-md hover:shadow-lg mb-4">
                                                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                        </svg>
                                                        Add New Instructor </a>
                                                @if (Model.Instructors.Any()){
                                                        <div class="space-y-3">
                                                                @foreach (var instructor in Model.Instructors){
                                                                        <div class="flex items-center justify-between p-4 bg-white rounded-xl border border-blue-200">
                                                                                <div class="flex items-center">
                                                                                        <div class="h-10 w-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                                                                                                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                                                                </svg>
                                                                                        </div>
                                                                                        <div>
                                                                                                <p class="font-semibold text-slate-900">@instructor.FullName</p>
                                                                                                <p class="text-sm text-slate-500">Instructor@instructor.Id</p>
                                                                                        </div>
                                                                                </div>
                                                                                <a asp-controller="Instructors" asp-action="InstructorDetails" asp-route-intructorId="@instructor.Id" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors font-medium"> View </a>
                                                                                <button data-instructor-id="@instructor.Id" data-instructor-fullname="@instructor.FullName" class="remove-course-instructor px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-all duration-200 font-medium">Remove</button>
                                                                        </div>
                                                                }
                                                        </div>
                                                }
                                                else{
                                                        <div class="text-center py-8">
                                                                <div class="mx-auto h-16 w-16 bg-blue-50 rounded-full flex items-center justify-center mb-4">
                                                                        <svg class="h-8 w-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                                        </svg>
                                                                </div>
                                                                <p class="text-blue-500">No instructors assigned yet</p>
                                                        </div>
                                                }
                                        </div>
                                </div>
                        </div>
                        <!-- Prerequisite Courses Section -->
                        <div class="bg-white rounded-lg shadow-sm border border-blue-200 overflow-hidden">
                                <div class="bg-blue-600 px-8 py-6">
                                        <h3 class="text-xl font-semibold text-white flex items-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link mr-3">
                                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L9.5 9.5"/>
                                                        <path d="M5 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L14.5 14.5"/>
                                                </svg>
                                                Prerequisite Courses
                                        </h3>
                                        <p class="text-blue-100 mt-1">Manage required courses for this course</p>
                                </div>
                                <div class="p-8 space-y-6">
                                        <div class="space-y-4">
                                                <h4 class="text-lg font-semibold text-slate-900 border-l-4 border-blue-500 pl-4">Current Prerequisites</h4>
                                                <a asp-controller="Courses" asp-action="AddPrerequisiteToCourse" asp-route-courseId="@Model.Id" class="group inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all duration-200 shadow-md hover:shadow-lg mb-4">
                                                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                        </svg>
                                                        Add Prerequisite </a>
                                                @if (Model.PrerequisiteCourses.Any()){
                                                        @await Component.InvokeAsync("PrerequisiteCourses", Model.Id)
                                                }
                                                else{
                                                        <div class="text-center py-8">
                                                                <div class="mx-auto h-16 w-16 bg-blue-50 rounded-full flex items-center justify-center mb-4">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link-2 text-blue-400">
                                                                                <path d="M9 17.01V17"/>
                                                                                <path d="M15 17.01V17"/>
                                                                                <path d="M12 17.01V17"/>
                                                                                <path d="M12 13.01V13"/>
                                                                                <path d="M12 9.01V9"/>
                                                                                <path d="M12 5.01V5"/>
                                                                                <path d="M17 17.01V17"/>
                                                                                <path d="M17 13.01V13"/>
                                                                                <path d="M17 9.01V9"/>
                                                                                <path d="M17 5.01V5"/>
                                                                                <path d="M7 17.01V17"/>
                                                                                <path d="M7 13.01V13"/>
                                                                                <path d="M7 9.01V9"/>
                                                                                <path d="M7 5.01V5"/>
                                                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
                                                                                <path d="M14 2v6h6"/>
                                                                        </svg>
                                                                </div>
                                                                <p class="text-blue-500">No prerequisite courses assigned yet</p>
                                                        </div>
                                                }
                                        </div>
                                </div>
                        </div>
                </div>
                <!-- Section Management Section (Bottom Row) -->
                <div class="mt-8">
                        <div class="bg-white rounded-lg shadow-sm border border-blue-200 overflow-hidden">
                                <div class="bg-blue-600 px-8 py-6">
                                        <h3 class="text-xl font-semibold text-white flex items-center">
                                                <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                                                </svg>
                                                Section Management
                                        </h3>
                                        <p class="text-blue-100 mt-1">Manage sections for this course</p>
                                </div>
                                <div class="p-8 space-y-6">
                                        <div class="space-y-4">
                                                <h4 class="text-lg font-semibold text-slate-900 border-l-4 border-blue-500 pl-4">Current Sections</h4>
                                                <a asp-controller="Sections" asp-action="Add" asp-route-facultyId="@Model.Faculty.Id" class="group inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all duration-200 shadow-md hover:shadow-lg mb-4">
                                                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                        </svg>
                                                        Add New Section </a>
                                                @if (Model.Sections.Any()){
                                                        <div class="overflow-x-auto">
                                                                <table class="min-w-full divide-y divide-blue-300">
                                                                        <thead class="bg-blue-50">
                                                                                <tr>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                                                Section ID
                                                                                        </th>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                                                Day / Time
                                                                                        </th>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                                                Classroom
                                                                                        </th>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                                                Instructor
                                                                                        </th>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                                                                Exam Date
                                                                                        </th>
                                                                                        <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                                                                Actions
                                                                                        </th>
                                                                                </tr>
                                                                        </thead>
                                                                        <tbody class="bg-white divide-y divide-blue-300">
                                                                                @foreach (var sec in Model.Sections){
                                                                                        <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                                                                                <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                                                                        <div class="text-sm font-medium text-slate-900">@sec.Id
                                                                                                        </div>
                                                                                                </td>
                                                                                                <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                                                                        <div class="text-sm text-slate-900">@sec.DayOfWeek -@sec.TimeSlot
                                                                                                        </div>
                                                                                                </td>
                                                                                                <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                                                                        <div class="text-sm text-slate-900">@sec.Classroom.ClassroomNumber
                                                                                                        </div>
                                                                                                </td>
                                                                                                <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                                                                        <div class="text-sm text-slate-900">@sec.Instructor.FullName
                                                                                                        </div>
                                                                                                </td>
                                                                                                <td class="px-6 py-4 whitespace-nowrap border-r border-blue-300">
                                                                                                        <div class="text-sm text-slate-900">@sec.ExamDate.ToShortDateString()
                                                                                                        </div>
                                                                                                </td>
                                                                                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                                                                        <a asp-controller="Sections" asp-action="SectionDetails" asp-route-sectionId="@sec.Id" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
                                                                                                        <button data-section-id="@sec.Id" class="remove-section text-red-600 hover:text-red-900">Remove</button>
                                                                                                </td>
                                                                                        </tr>
                                                                                }
                                                                        </tbody>
                                                                </table>
                                                        </div>
                                                }
                                                else{
                                                        <div class="text-center py-8">
                                                                <div class="mx-auto h-16 w-16 bg-blue-50 rounded-full flex items-center justify-center mb-4">
                                                                        <svg class="h-8 w-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                                                                        </svg>
                                                                </div>
                                                                <p class="text-blue-500">No sections assigned yet</p>
                                                        </div>
                                                }
                                        </div>
                                </div>
                        </div>
                </div>
                <!-- Back Navigation -->
                <div class="text-center">
                        <a asp-controller="Admin" asp-action="Courses" asp-route-facultyId="@Model.Faculty.Id" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors group font-medium">
                                <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                </svg>
                                Back to Course Management </a>
                </div>
        </div>
</div>

<!-- Remove Confirmation Modal -->
<div id="confirmRemoveCourseInstructorModal" class="fixed z-50 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <form id="removeCourseInstructor" asp-controller="Instructors" asp-action="RemoveCourseInstructor">
                @Html.AntiForgeryToken()
                <input type="hidden" name="instructorId" id="instructorId" value=""/>
                <input type="hidden" name="courseId" value="@Model.Id"/>
        </form>
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <!-- Background overlay -->
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
                <!-- Modal panel -->
                <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <div class="sm:flex sm:items-start">
                                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                                                <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                                </svg>
                                        </div>
                                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                                <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                                                        Remove Classroom </h3>
                                                <div class="mt-2">
                                                        <p class="text-sm text-gray-500">
                                                                Are you sure you want to remove
                                                                <span id="instructorFullName" class="font-medium"></span> from this course?
                                                        </p>
                                                </div>
                                        </div>
                                </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                                <button type="button" id="confirmRemoveCourseInstructorBtn" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
                                        Remove
                                </button>
                                <button type="button" id="cancelRemoveCourseInstructorBtn" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                        Cancel
                                </button>
                        </div>
                </div>
        </div>
</div>
<script>
        // Modal functionality
        const confirmRemoveCourseInstructorModal = document.getElementById('confirmRemoveCourseInstructorModal');
        const confirmRemoveCourseInstructorBtn = document.getElementById('confirmRemoveCourseInstructorBtn');
        const cancelRemoveCourseInstructorBtn = document.getElementById('cancelRemoveCourseInstructorBtn');
        const instructorFullName = document.getElementById('instructorFullName');

        let currentStudentToRemove = null;

        // Function to open the modal
        function openRemoveModal(instructorId, instructorName) {
                currentStudentToRemove = instructorId;
                instructorFullName.textContent = instructorName;
                confirmRemoveCourseInstructorModal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
        }

        // Function to close the modal
        function closeRemoveModal() {
                confirmRemoveCourseInstructorModal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
                currentStudentToRemove = null;
        }

        // Event listeners for modal buttons
        confirmRemoveCourseInstructorBtn.addEventListener('click', function () {
                if (currentStudentToRemove) {
                        console.log(currentStudentToRemove)
                        removeStudent(currentStudentToRemove);

                }
                closeRemoveModal();
        });

        cancelRemoveCourseInstructorBtn.addEventListener('click', closeRemoveModal);

        // Close modal when clicking outside
        confirmRemoveCourseInstructorModal.addEventListener('click', function (e) {
                if (e.target === confirmRemoveCourseInstructorModal) {
                        closeRemoveModal();
                }
        });

        // Function to handle student removal
        async function removeStudent(instructorId) {
                document.getElementById('instructorId').value = instructorId;
                document.getElementById('removeCourseInstructor').submit();

        }

        // Update your existing remove button event listeners
        document.addEventListener('click', function (e) {
                if (e.target.closest('.remove-course-instructor')) {
                        e.preventDefault();
                        const button = e.target.closest('.remove-course-instructor');
                        const instructorId = button.getAttribute('data-instructor-id');
                        const instructorFullName = button.getAttribute('data-instructor-fullname');
                        console.log(instructorId, instructorFullName)
                        openRemoveModal(instructorId, instructorFullName);
                }
        });
</script>