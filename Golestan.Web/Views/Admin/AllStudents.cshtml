@model List<FacultyDto>

<div class="container mx-auto px-6 py-12">
        <!-- Enhanced Header Section -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 mb-8 overflow-hidden">
                <div class="bg-blue-700 px-8 py-6">
                        <div class="flex justify-between items-center">
                                <div>
                                        <p class="text-3xl font-bold text-white mb-2">Faculty Management System</p>
                                        <p class="text-blue-300 text-lg">Comprehensive faculty and classroom administration</p>
                                </div>
                                <a asp-controller="Faculties" asp-action="AddFaculty" class="group">
                                        <div class="bg-white hover:bg-blue-50 text-blue-700 px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md hover:shadow-lg">
                                                <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                                Add New Faculty
                                        </div>
                                </a>
                        </div>
                </div>
        </div>
        <!-- Enhanced Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-blue-800 uppercase tracking-wider mb-1">Total Faculties</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Count</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-blue-800 uppercase tracking-wider mb-1">Total students</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Sum(f => f.StudentsCount)</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-blue-800 uppercase tracking-wider mb-1">Active Programs</p>
                                <p class="text-2xl font-bold text-slate-900">@Model.Count(f => f.CoursesCount > 0)</p>
                        </div>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
                        <div class="text-center">
                                <p class="text-xs font-medium text-blue-800 uppercase tracking-wider mb-1">Avg Unit</p>
                                <p class="text-2xl font-bold text-slate-900">@(Model.Count > 0 ? Math.Round((double)Model.Sum(f => f.ClassesCount) / Model.Count, 1) : 0)</p>
                        </div>
                </div>
        </div>
        <!-- Enhanced Faculty Table -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
                <div class="px-8 py-6 border-b border-blue-300">
                        <div class="flex items-center justify-between">
                                <div>
                                        <h2 class="text-2xl font-bold text-slate-900">Faculty Directory</h2>
                                        <p class="text-slate-600 mt-1">Manage faculty departments and sections</p>
                                </div>
                                <div class="flex items-center space-x-2">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">@Model.Count Total</span>
                                </div>
                        </div>
                </div>
                @if (Model.Count > 0){
                        <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-blue-300">
                                        <thead class="bg-blue-50">
                                                <tr>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-blue-900 uppercase tracking-wider border-r border-blue-300">
                                                                Faculty ID
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-blue-900 uppercase tracking-wider border-r border-blue-300">
                                                                Major
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-blue-900 uppercase tracking-wider border-r border-blue-300">
                                                                Students Count
                                                        </th>
                                                        <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-blue-900 uppercase tracking-wider">
                                                                Management
                                                        </th>
                                                </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-blue-300">
                                                @foreach (var faculty in Model){
                                                        <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                                                                        <span class="text-white font-bold text-lg">#</span>
                                                                                </div>
                                                                                <div class="ml-4">
                                                                                        <div class="text-lg font-bold text-slate-900">@faculty.Id</div>
                                                                                        <div class="text-sm text-blue-700">Faculty Code</div>
                                                                                </div>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                            </svg>
                                                @faculty.MajorName
                                        </span>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                        <div class="flex items-center">
                                                                                <div class="text-2xl font-bold text-slate-900">@faculty.StudentsCount</div>
                                                                                <div class="ml-2 text-sm text-blue-700">Students</div>
                                                                        </div>
                                                                </td>
                                                                <td class="px-8 py-6 whitespace-nowrap">
                                                                        <a asp-controller="Admin" asp-action="ManageStudents" asp-route-facultyId="@faculty.Id" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg transition-all duration-200 shadow-md group">
                                                                                <svg class="w-5 h-5 mr-3 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                                                </svg>
                                                                                Manage Students
                                                                                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                                                </svg>
                                                                        </a>
                                                                </td>
                                                        </tr>
                                                }
                                        </tbody>
                                </table>
                        </div>
                }
                else{
                        <div class="text-center py-16 border-t border-blue-200">
                                <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                                        <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                        </svg>
                                </div>
                                <h3 class="text-xl font-semibold text-slate-900 mb-2">No Faculties Found</h3>
                                <p class="text-slate-600 mb-8 max-w-md mx-auto">Get started by adding your first faculty department to begin managing classrooms and academic programs.</p>
                                <a asp-controller="Faculties" asp-action="AddFaculty" class="inline-flex items-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg shadow-md transition-all duration-200">
                                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        Add First Faculty
                                </a>
                        </div>
                }
        </div>
        <!-- Enhanced Pagination -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 px-8 py-6 mt-8">
                <div class="flex items-center justify-between">
                        <div class="flex-1 flex justify-between sm:hidden">
                                <a href="#" class="relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 hover:text-blue-900 transition-all duration-200"> Previous </a>
                                <a href="#" class="ml-3 relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 hover:text-blue-900 transition-all duration-200"> Next </a>
                        </div>
                        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                                <div>
                                        <p class="text-sm font-medium text-slate-700">
                                                Showing <span class="font-bold text-slate-900">1</span> to
                                                <span class="font-bold text-slate-900">@Model.Count</span> of
                                                <span class="font-bold text-slate-900">@Model.Count</span> results
                                        </p>
                                </div>
                                <div>
                                        <nav class="relative z-0 inline-flex rounded-lg shadow-sm border border-blue-200 -space-x-px" aria-label="Pagination">
                                                <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-l-lg border-r border-blue-200 bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-900 transition-all duration-200">
                                                        <span class="sr-only">Previous</span>
                                                        <i class="fas fa-chevron-left h-5 w-5"></i>
                                                </a>
                                                <a href="#" class="relative inline-flex items-center px-6 py-3 border-r border-blue-200 bg-blue-600 text-sm font-bold text-white transition-all duration-200"> 1 </a>
                                                <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-r-lg bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-900 transition-all duration-200">
                                                        <span class="sr-only">Next</span>
                                                        <i class="fas fa-chevron-right h-5 w-5"></i>
                                                </a>
                                        </nav>
                                </div>
                        </div>
                </div>
        </div>
</div>
