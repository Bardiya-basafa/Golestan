@model List<CourseDto>
@{
    var facultyId = ViewBag.FacultyId;
    var facultyName = ViewBag.FacultyName;
}

<div class="container mx-auto px-6 py-12">
    <!-- Enhanced Header Section -->
    <div class="bg-white rounded-lg shadow-sm border border-blue-200 mb-8 overflow-hidden">
        <div class="bg-blue-700 px-8 py-6">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-3xl font-bold text-white mb-2">
                        <strong>@facultyName</strong> Courses
                    </p>
                    <p class="text-blue-300 text-lg">Comprehensive academic course administration</p>
                </div>
                <a asp-controller="Courses" asp-action="Add" asp-route-facultyId="@facultyId" class="group">
                    <div class="bg-white hover:bg-blue-50 text-blue-700 px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md hover:shadow-lg">
                        <svg class="w-5 h-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Add New Course
                    </div>
                </a>
            </div>
        </div>
    </div>
    <!-- Enhanced Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
            <div class="text-center">
                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Total Courses</p>
                <p class="text-2xl font-bold text-slate-900">@Model.Count</p>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
            <div class="text-center">
                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Total Units</p>
                <p class="text-2xl font-bold text-slate-900">@Model.Sum(c => c.Unit)</p>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
            <div class="text-center">
                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Average Units</p>
                <p class="text-2xl font-bold text-slate-900">@(Model.Count > 0 ? Math.Round((double)Model.Sum(c => c.Unit) / Model.Count, 1) : 0)</p>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-4">
            <div class="text-center">
                <p class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Longest Course</p>
                <p class="text-2xl font-bold text-slate-900">@(Model.Count > 0 ? Model.Max(c => c.Unit) : 0)</p>
            </div>
        </div>
    </div>
    <!-- Enhanced Course Table -->
    <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
        <div class="px-8 py-6 border-b border-blue-300">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">Course Directory</h2>
                    <p class="text-slate-600 mt-1">Manage academic courses and curriculum</p>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                        @Model.Count Total
                    </span>
                </div>
            </div>
        </div>
        @if (Model.Count > 0){
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-blue-300">
                    <thead class="bg-blue-50">
                        <tr>
                            <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                Course ID
                            </th>
                            <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                Course Name
                            </th>
                            <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                Units
                            </th>
                            <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                Exam Date
                            </th>
                            <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                Management
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-blue-300">
                        @foreach (var course in Model){
                            <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                            <span class="text-white font-bold text-lg">#</span>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-lg font-bold text-slate-900">@course.Id</div>
                                            <div class="text-sm text-slate-500">Course Code</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                    <div class="flex items-center">
                                        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                            </svg>
                                            @course.CourseName
                                        </span>
                                    </div>
                                </td>
                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                    <div class="flex items-center">
                                        <div class="text-2xl font-bold text-slate-900">@course.Unit</div>
                                        <div class="ml-2 text-sm text-slate-500">units</div>
                                    </div>
                                </td>
                                <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                    <div class="flex items-center">
                                        @await Component.InvokeAsync("CourseExam", course.Id)
                                    </div>
                                </td>
                                <td class="px-8 py-6 whitespace-nowrap">
                                    <a asp-controller="Courses" asp-action="Index" asp-route-courseId="@course.Id" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-all duration-200 shadow-md group"> Manage
                                        <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                    <button data-course-id="@course.Id" data-course-name="@course.CourseName" class="remove-course px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-all duration-200 font-medium">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else{
            <div class="text-center py-16 border-t border-blue-200">
                <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                    <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-slate-900 mb-2">No Courses Found</h3>
                <p class="text-slate-600 mb-8 max-w-md mx-auto">Get started by adding your first course to begin building your academic curriculum.</p>
                <a asp-controller="Courses" asp-action="Add" asp-route-facultyId="@facultyId" class="inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Add First Course
                </a>
            </div>
        }
    </div>
    <!-- Enhanced Pagination -->
    <div class="bg-white rounded-lg shadow-sm border border-blue-200 px-8 py-6 mt-8">
        <div class="flex items-center justify-between">
            <div class="flex-1 flex justify-between sm:hidden">
                <a href="#" class="relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 transition-all duration-200">Previous</a>
                <a href="#" class="ml-3 relative inline-flex items-center px-6 py-3 border border-blue-300 text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-blue-50 transition-all duration-200">Next</a>
            </div>
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-700">
                        Showing <span class="font-bold text-slate-900">1</span> to
                        <span class="font-bold text-slate-900">@Model.Count</span> of
                        <span class="font-bold text-slate-900">@Model.Count</span> results
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-lg shadow-sm border border-blue-200 -space-x-px" aria-label="Pagination">
                        <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-l-lg border-r border-blue-200 bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 transition-all duration-200">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                        <a href="#" class="relative inline-flex items-center px-6 py-3 border-r border-blue-200 bg-blue-600 text-sm font-bold text-white transition-all duration-200">1</a>
                        <a href="#" class="relative inline-flex items-center px-4 py-3 rounded-r-lg bg-white text-sm font-semibold text-slate-700 hover:bg-blue-50 transition-all duration-200">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Remove Confirmation Modal -->
<div id="confirmRemoveCourseModal" class="fixed z-50 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <form id="removeCourse" asp-controller="Courses" asp-action="Remove">
        @Html.AntiForgeryToken()
        <input type="hidden" name="courseId" id="courseId" value=""/>
        <input type="hidden" name="facultyId" value="@facultyId"/>
    </form>
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                        <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                            Remove Classroom </h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500">
                                Are you sure you want to remove
                                <span id="courseName" class="font-medium"></span> from this faculty? </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" id="confirmRemoveCourseModalBtn" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
                    Remove
                </button>
                <button type="button" id="cancelRemoveCourseBtn" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    // Modal functionality
    const confirmRemoveCourseModal = document.getElementById('confirmRemoveCourseModal');
    const confirmRemoveCourseModalBtn = document.getElementById('confirmRemoveCourseModalBtn');
    const cancelRemoveCourseBtn = document.getElementById('cancelRemoveCourseBtn');
    const courseName = document.getElementById('courseName');

    let currentStudentToRemove = null;

    // Function to open the modal
    function openRemoveModal(courseId, courseName) {
        currentStudentToRemove = courseId;
        courseName.textContent = courseName;
        confirmRemoveCourseModal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    // Function to close the modal
    function closeRemoveModal() {
        confirmRemoveCourseModal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        currentStudentToRemove = null;
    }

    // Event listeners for modal buttons
    confirmRemoveCourseModalBtn.addEventListener('click', function () {
        if (currentStudentToRemove) {
            console.log(currentStudentToRemove)
            removeStudent(currentStudentToRemove);

        }
        closeRemoveModal();
    });

    cancelRemoveCourseBtn.addEventListener('click', closeRemoveModal);

    // Close modal when clicking outside
    confirmRemoveCourseModal.addEventListener('click', function (e) {
        if (e.target === confirmRemoveCourseModal) {
            closeRemoveModal();
        }
    });

    // Function to handle student removal
    async function removeStudent(courseId) {
        document.getElementById('courseId').value = courseId;
        document.getElementById('removeCourse').submit();

    }

    // Update your existing remove button event listeners
    document.addEventListener('click', function (e) {
        if (e.target.closest('.remove-course')) {
            e.preventDefault();
            const button = e.target.closest('.remove-course');
            const courseId = button.getAttribute('data-course-id');
            const courseName = button.getAttribute('data-course-name');
            console.log(courseId, courseName)
            openRemoveModal(courseId, courseName);
        }
    });
</script>