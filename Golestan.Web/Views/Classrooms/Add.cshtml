@model AddClassroomDto

@{
        ViewData["Title"] = "Add New Classroom";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl w-full space-y-8">
                <!-- Header -->
                <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                        <div class="px-8 py-6 border-b border-blue-500">
                                <div class="flex justify-between items-center">
                                        <div>
                                                <p class="text-3xl font-bold text-white mb-2">Add New Classroom</p>
                                                <p class="text-blue-100 text-lg">to <strong>@Model.FacultyName</strong> Faculty</p>
                                        </div>
                                        <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center shadow-md">
                                                <i class="fas fa-plus text-blue-600 text-3xl"></i>
                                        </div>
                                </div>
                        </div>
                </div>

                <!-- Form Card -->
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 overflow-hidden">
                        <div class="px-8 py-6 bg-blue-600">
                                <h3 class="text-xl font-semibold text-white">Classroom Information</h3>
                                <p class="text-blue-100 mt-1">Please fill in all required fields</p>
                        </div>
                        <form class="px-8 py-8 space-y-6" asp-controller="Classrooms" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                @if (!ViewData.ModelState.IsValid){
                                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8 animate-fade-in">
                                                <div class="flex items-start">
                                                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                                                                <i class="fas fa-exclamation-triangle text-white text-sm"></i>
                                                        </div>
                                                        <div>
                                                                <h3 class="text-lg font-semibold text-blue-800 mb-2">Please correct the following errors:</h3>
                                                                <div class="mt-3 text-sm text-blue-700" asp-validation-summary="All"></div>
                                                        </div>
                                                </div>
                                        </div>
                                }
                                <input type="hidden" value="@Model.FacultyId" asp-for="FacultyId"/>
                                <!-- Classroom Information Section -->
                                <div class="space-y-6">
                                        <div class="border-l-4 border-blue-600 pl-4">
                                                <h4 class="text-lg font-semibold text-slate-900 mb-4">Classroom Details</h4>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                <!-- Class number -->
                                                <div class="group">
                                                        <label asp-for="ClassNumber" class="block text-sm font-bold text-slate-700 mb-2">Class Number
                                                                <span class="text-red-500">*</span> </label>
                                                        <div class="relative">
                                                                <input type="text" asp-for="ClassNumber" placeholder="Enter class number" value="@Model.ClassNumber" class="w-full px-4 py-3 border border-blue-200 rounded-lg shadow-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 group-hover:border-blue-300" required>
                                                                <span asp-validation-for="ClassNumber" class="text-red-600"></span>
                                                        </div>
                                                        <p class="text-xs text-slate-500 mt-1">Enter class number</p>
                                                </div>
                                                <!-- Capacity -->
                                                <div class="group">
                                                        <label asp-for="Capacity" class="block text-sm font-bold text-slate-700 mb-2"> Class Capacity
                                                                <span class="text-red-500">*</span> </label>
                                                        <div class="relative">
                                                                <input type="number" asp-for="Capacity" min="10" max="150" step="1" placeholder="50" value="@Model.Capacity" class="w-full px-4 py-3 border border-blue-200 rounded-lg shadow-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 group-hover:border-blue-300" required>
                                                        </div>
                                                        <span asp-validation-for="Capacity" class="text-red-600"></span>
                                                        <p class="text-xs text-slate-500 mt-1">Enter class capacity</p>
                                                </div>
                                        </div>
                                </div>
                                <!-- Action Buttons -->
                                <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-blue-200">
                                        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        <span class="flex items-center justify-center">
                            <i class="fas fa-plus w-5 h-5 mr-2"></i>
                            Create Classroom
                        </span>
                                        </button>
                                        <button type="reset" class="flex-1 bg-white hover:bg-blue-50 text-slate-700 font-semibold py-3 px-6 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 text-center focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 border border-blue-200">
                        <span class="flex items-center justify-center">
                            <i class="fas fa-undo w-5 h-5 mr-2"></i>
                            Reset Form
                        </span>
                                        </button>
                                </div>
                                <!-- Back Link -->
                                <div class="text-center pt-4">
                                        <a asp-controller="Admin" asp-action="ManageFacultyClassrooms" asp-route-facultyId="@Model.FacultyId" class="inline-flex items-center text-sm text-blue-600 hover:text-blue-700 transition-colors group">
                                                <i class="fas fa-arrow-left w-4 h-4 mr-1 group-hover:-translate-x-1 transition-transform"></i>
                                                Back to Classroom List
                                        </a>
                                </div>
                        </form>
                </div>
        </div>
</div>
