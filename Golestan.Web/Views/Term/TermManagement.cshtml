@model TermDto?
@{
        ViewData["Title"] = "Term Management";
}


<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
                <!-- Header -->
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 mb-8 overflow-hidden">
                        <div class="px-8 py-6 border-b border-blue-200">
                                <div class="flex justify-between items-center">
                                        <div>
                                                <p class="text-3xl font-bold text-slate-900 mb-2">Academic Term Management</p>
                                                <p class="text-slate-600 text-lg">Oversee and configure academic terms</p>
                                        </div>
                                        <a asp-controller="Term" asp-action="Terms" class="group">
                                                <div class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 flex items-center shadow-md">
                                                        All Terms History
                                                </div>
                                        </a>
                                </div>
                        </div>
                </div>
                @if (Model != null){
                        <!-- Current Term Details -->
                        <div class="bg-white rounded-xl shadow-lg border border-blue-200 p-8 mb-8 animate-fade-in">
                                <h2 class="text-2xl font-bold text-slate-900 mb-6 border-b pb-4">Current Active Term</h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-slate-700">
                                        <div>
                                                <p class="text-sm font-semibold text-blue-800 uppercase tracking-wider mb-1">Term Identifier</p>
                                                <p class="text-xl font-bold text-slate-900">@Model.TermIdentifier</p>
                                                <p class="text-sm text-blue-700 mt-1">Year: @Model.Year</p>
                                        </div>
                                        <div>
                                                <p class="text-sm font-semibold text-blue-800 uppercase tracking-wider mb-1">Exams Period</p>
                                                <p class="text-lg font-medium">@Model.ExamsStartTime.ToString("MMM dd, yyyy") - @Model.ExamsEndTime.ToString("MMM dd, yyyy")</p>
                                        </div>
                                        <div>
                                                <p class="text-sm font-semibold text-blue-800 uppercase tracking-wider mb-1">Section Selection</p>
                                                <p class="text-lg font-medium">@Model.SelectionStartTime.ToString("MMM dd, yyyy") - @Model.SelectionEndTime.ToString("MMM dd, yyyy")</p>
                                        </div>
                                </div>
                        </div>
                        <!-- Actions for Existing Term -->
                        <div class="bg-white rounded-xl shadow-lg border border-blue-200 p-8 mb-8 animate-fade-in">
                                <h2 class="text-2xl font-bold text-slate-900 mb-6 border-b pb-4">Term Actions</h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <a asp-controller="Terms" asp-action="CloseTerm" asp-route-id="@Model.Id" class="block w-full py-4 px-6 bg-blue-600 text-white font-bold text-center rounded-lg transition-colors duration-200"> Close Term </a>
                                        <a asp-controller="Terms" asp-action="EditTerm" asp-route-id="@Model.Id" class="block w-full py-4 px-6 bg-blue-600 text-white font-bold text-center rounded-lg transition-colors duration-200"> Edit This Term </a>
                                        <!-- Removed "Open New Term" button as requested -->
                                </div>
                        </div>
                }
                else{
                        <!-- No Term Found State -->
                        <div class="bg-white rounded-xl shadow-lg border border-blue-200 p-12 text-center mb-8 animate-fade-in">
                                <h2 class="text-2xl font-bold text-slate-900 mb-4">No Active Term Found</h2>
                                <p class="text-slate-600 text-lg mb-8 max-w-md mx-auto">
                                        There is currently no academic term configured. Please create a new term to begin. </p>
                                <a asp-controller="Term" asp-action="OpenNewTerm" class="inline-block py-4 px-8 bg-blue-600 text-white font-bold rounded-lg shadow-md transition-all duration-200"> Open New Term </a>
                        </div>
                }
                <!-- Back Link -->
                <div class="text-center mt-8">
                        <a asp-controller="Admin" asp-action="AdminDashboard" class="inline-block text-blue-800 hover:text-blue-900 font-medium"> Back to Admin Dashboard </a>
                </div>
        </div>
</div>
