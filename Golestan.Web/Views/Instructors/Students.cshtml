@model List<StudentDto>

<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header Section -->
        <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
            <div class="px-8 py-6 border-b border-blue-500">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-3xl font-bold text-white mb-2">Students List</p>
                        <p class="text-blue-100 text-lg">Comprehensive student administration and oversight</p>
                    </div>
                    <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-md">
                        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Total Students</p>
                        <p class="text-3xl font-bold text-slate-900">@Model.Count</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Average GPA</p>
                        <p class="text-3xl font-bold text-slate-900">@(Model.Any(s => s.Gpa != -1) ? Model.Where(s => s.Gpa != -1).Sum(s => s.Gpa) / Model.Count(s => s.Gpa != -1) : "-")</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20V10"></path>
                            <path d="M18 20V4"></path>
                            <path d="M6 20v-4"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Total Students Enrolled</p>
                        <p class="text-3xl font-bold text-slate-900">@Model.Count</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Graduating This Year</p>
                        @* <p class="text-3xl font-bold text-slate-900">@Model.GraduatingThisYear</p> *@
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <!-- Students Table -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
            <div class="px-8 py-6 border-b border-blue-300">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Student Directory</h2>
                        <p class="text-slate-600 mt-1">Manage student profiles and academic records</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                            @Model.Count Total Students
                        </span>
                    </div>
                </div>
            </div>
            @if (Model.Count > 0){
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-blue-300">
                        <thead class="bg-blue-50">
                            <tr>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Student Info
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Student Number
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Total Sections
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    GPA
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Email
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-blue-300">
                            @foreach (var student in Model){
                                <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                    <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                                <span class="text-white font-bold text-lg">#@student.Id</span>
                                            </div>
                                            <div class="ml-4">
                                                <div class="text-lg font-bold text-slate-900">@student.FullName</div>
                                                <div class="text-sm text-slate-500">ID: @student.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                        <div class="text-lg font-bold text-slate-900">@student.StudentNumber</div>
                                        <div class="text-sm text-slate-500">University ID</div>
                                    </td>
                                    <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                                            </svg>
                                            @student.Sections.Count
                                        </span>
                                    </td>
                                    <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                        <div class="text-lg font-bold text-slate-900">@(student.Gpa == -1 ? "No Exam Result Available" : student.Gpa)</div>
                                        <div class="text-sm text-slate-500">GPA</div>
                                    </td>
                                    <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                        <div class="text-sm font-semibold text-slate-900">@student.Email</div>
                                        <div class="text-xs text-slate-500">Primary Contact</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else{
                <!-- No Students Found Message -->
                <div class="text-center py-16 border-t border-blue-200">
                    <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                        <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-900 mb-2">No Students Found</h3>
                </div>
            }
        </div>
        <!-- Back Navigation -->
        <div class="mt-8 text-center">
            <a asp-controller="Instructors" asp-action="Sections" asp-route-instructorId="@((int)ViewBag.instructorId)" class="inline-flex items-center text-blue-800 hover:text-blue-900 transition-colors group font-medium">
                <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Sections </a>
        </div>
    </div>
</div>
