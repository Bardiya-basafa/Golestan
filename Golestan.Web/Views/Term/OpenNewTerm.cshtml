@{
        ViewData["Title"] = "Add New Term";
}

<body class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-rose-50">

        <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
                <div class="max-w-4xl mx-auto">
                        <!-- Header -->
                        <div class="text-center mb-12 animate-fade-in">
                                <div class="mx-auto h-20 w-20 bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center shadow-xl mb-6">
                                        <i class="fas fa-calendar-plus text-white text-3xl"></i>
                                </div>
                                <h1 class="text-4xl font-bold text-gray-800 mb-3">Create New Academic Term</h1>
                                <p class="text-gray-600 text-lg font-medium">Set up dates and schedules for the upcoming term</p>
                        </div>

                        <!-- Form Container -->
                        <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden animate-fade-in card-hover">
                                <!-- Form Header -->
                                <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-8 py-6">
                                        <h2 class="text-2xl font-bold text-white flex items-center">
                                                <i class="fas fa-calendar-alt mr-3"></i>
                                                Term Configuration
                                        </h2>
                                        <p class="text-purple-100 mt-2">Configure all important dates for the academic term</p>
                                </div>

                                <!-- Form Content -->
                                <div class="p-8">
                                        <form asp-controller="Terms" asp-action="Create" method="post">
                                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                                        <!-- Left Column - Term Period -->
                                                        <div class="space-y-6">
                                                                <div class="bg-purple-50 rounded-2xl p-6 border border-purple-100">
                                                                        <h3 class="text-xl font-bold text-purple-800 mb-4 flex items-center">
                                                                                <i class="fas fa-calendar-week mr-2"></i>
                                                                                Term Period
                                                                        </h3>

                                                                        <!-- Start Date -->
                                                                        <div class="mb-6">
                                                                                <label for="startDate" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-play text-green-500 mr-2"></i>
                                                                                        Term Start Date
                                                                                </label>
                                                                                <input type="date" id="startDate" name="StartDate" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>

                                                                        <!-- End Date -->
                                                                        <div>
                                                                                <label for="endDate" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-stop text-red-500 mr-2"></i>
                                                                                        Term End Date
                                                                                </label>
                                                                                <input type="date" id="endDate" name="EndDate" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>
                                                                </div>

                                                                <!-- Exams Period -->
                                                                <div class="bg-rose-50 rounded-2xl p-6 border border-rose-100">
                                                                        <h3 class="text-xl font-bold text-rose-800 mb-4 flex items-center">
                                                                                <i class="fas fa-file-alt mr-2"></i>
                                                                                Examination Period
                                                                        </h3>

                                                                        <!-- Exams Start Time -->
                                                                        <div class="mb-6">
                                                                                <label for="examsStartTime" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-clock text-blue-500 mr-2"></i>
                                                                                        Exams Start Date
                                                                                </label>
                                                                                <input type="date" id="examsStartTime" name="ExamsStartTime" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>

                                                                        <!-- Exams End Time -->
                                                                        <div>
                                                                                <label for="examsEndTime" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-clock text-orange-500 mr-2"></i>
                                                                                        Exams End Date
                                                                                </label>
                                                                                <input type="date" id="examsEndTime" name="ExamsEndTime" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>
                                                                </div>
                                                        </div>

                                                        <!-- Right Column - Section Selection -->
                                                        <div class="space-y-6">
                                                                <div class="bg-emerald-50 rounded-2xl p-6 border border-emerald-100">
                                                                        <h3 class="text-xl font-bold text-emerald-800 mb-4 flex items-center">
                                                                                <i class="fas fa-users mr-2"></i>
                                                                                Section Selection Period
                                                                        </h3>

                                                                        <!-- Section Selection Start Time -->
                                                                        <div class="mb-6">
                                                                                <label for="sectionSelectionStartTime" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-door-open text-green-500 mr-2"></i>
                                                                                        Registration Opens
                                                                                </label>
                                                                                <input type="date" id="sectionSelectionStartTime" name="SectionSelectionStartTime" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>

                                                                        <!-- Section Selection End Time -->
                                                                        <div>
                                                                                <label for="sectionSelectionEndTime" class="block text-sm font-bold text-gray-700 mb-3">
                                                                                        <i class="fas fa-door-closed text-red-500 mr-2"></i>
                                                                                        Registration Closes
                                                                                </label>
                                                                                <input type="date" id="sectionSelectionEndTime" name="SectionSelectionEndTime" required
                                                                                       class="form-input w-full px-4 py-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200 text-gray-800 font-medium bg-white shadow-sm">
                                                                        </div>
                                                                </div>

                                                                <!-- Info Panel -->
                                                                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100">
                                                                        <h4 class="text-lg font-bold text-blue-800 mb-3 flex items-center">
                                                                                <i class="fas fa-info-circle mr-2"></i>
                                                                                Important Notes
                                                                        </h4>
                                                                        <ul class="text-sm text-blue-700 space-y-2">
                                                                                <li class="flex items-start">
                                                                                        <i class="fas fa-check-circle mt-1 mr-2 text-green-500"></i>
                                                                                        <span>Section selection should open before term starts</span>
                                                                                </li>
                                                                                <li class="flex items-start">
                                                                                        <i class="fas fa-check-circle mt-1 mr-2 text-green-500"></i>
                                                                                        <span>Exam period typically occurs at the end of term</span>
                                                                                </li>
                                                                                <li class="flex items-start">
                                                                                        <i class="fas fa-check-circle mt-1 mr-2 text-green-500"></i>
                                                                                        <span>All dates will be validated for logical sequence</span>
                                                                                </li>
                                                                        </ul>
                                                                </div>
                                                        </div>
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="flex flex-col sm:flex-row gap-4 mt-12 pt-8 border-t border-gray-200">
                                                        <a asp-controller="Admin" asp-action="TermsManagement"
                                                           class="flex-1 py-4 px-6 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl transition-all duration-200 text-center border border-gray-300 flex items-center justify-center">
                                                                <i class="fas fa-arrow-left mr-2"></i>
                                                                Cancel & Go Back
                                                        </a>
                                                        <button type="submit"
                                                                class="flex-1 py-4 px-6 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1 flex items-center justify-center">
                                                                <i class="fas fa-plus mr-2"></i>
                                                                Create Academic Term
                                                        </button>
                                                </div>
                                        </form>
                                </div>
                        </div>

                        <!-- Back Link -->
                        <div class="text-center mt-8">
                                <a asp-controller="Admin" asp-action="Index"
                                   class="inline-flex items-center text-gray-600 hover:text-purple-600 transition-colors font-medium text-lg">
                                        <i class="fas fa-home mr-2"></i>
                                        Return to Admin Dashboard
                                </a>
                        </div>
                </div>
        </div>

</body>         
