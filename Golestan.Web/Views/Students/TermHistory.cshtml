@model List<TermDto>
@{
        var studentId = (int)ViewBag.StudentId;
}
<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- Header Section -->
                <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                        <div class="px-8 py-6 border-b border-blue-500">
                                <div class="flex justify-between items-center">
                                        <div>
                                                <p class="text-3xl font-bold text-white mb-2">My Passed Terms</p>
                                                <p class="text-blue-100 text-lg">Review your academic history and completed terms</p>
                                        </div>
                                        <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-md">
                                                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                        </div>
                                </div>
                        </div>
                </div>
                @* Student Info *@
                @await Component.InvokeAsync("StudentInfo", studentId)
                <!-- Current Term Details (Table/Box Style) -->
                @await Component.InvokeAsync("CurrentTerm")
                <!-- Passed Terms Table -->
                <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
                        <div class="px-8 py-6 border-b border-blue-300">
                                <div class="flex items-center justify-between">
                                        <div>
                                                <h2 class="text-2xl font-bold text-slate-900">Academic Terms History</h2>
                                                <p class="text-slate-600 mt-1">Overview of all terms you have successfully completed</p>
                                        </div>
                                        <div class="flex items-center space-x-2">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                            @Model.Count Terms
                        </span>
                                        </div>
                                </div>
                        </div>
                        @if (Model.Count > 0){
                                <div class="overflow-x-auto">
                                        <table class="min-w-full divide-y divide-blue-300">
                                                <thead class="bg-blue-50">
                                                        <tr>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                        Term ID
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                        Term Identifier
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                        Year
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                        Selection Period
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                                                        Exams Period
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                                        Status
                                                                </th>
                                                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                                        Exams
                                                                </th>
                                                        </tr>
                                                </thead>
                                                <tbody class="bg-white divide-y divide-blue-300">
                                                        @foreach (var term in Model){
                                                                <!-- Placeholder Data -->
                                                                <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <div class="flex items-center">
                                                                                        <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                                                                                <span class="text-white font-bold text-lg">#@term.Id</span>
                                                                                        </div>
                                                                                        <div class="ml-4">
                                                                                                <div class="text-lg font-bold text-slate-900">Term ID</div>
                                                                                        </div>
                                                                                </div>
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <div class="text-lg font-bold text-slate-900">@term.TermIdentifier</div>
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <div class="text-lg font-bold text-slate-900">@term.Year</div>
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <div class="text-lg font-bold text-slate-900">@term.SelectionStartTime.ToString("yyyy-MM-dd") / @term.SelectionEndTime.ToString("yyyy-MM-dd")</div>
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <div class="text-lg font-bold text-slate-900">@term.ExamsStartTime.ToString("yyyy-MM-dd") / @term.ExamsEndTime.ToString("yyyy-MM-dd")</div>
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                @if (term.IsClosed){
                                                                                        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-green-100 text-green-800 border border-green-200">
                                                                                                        Finished
                                                                                                </span>
                                                                                }
                                                                                else{
                                                                                        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                                                                                        Active
                                                                                                </span>
                                                                                }
                                                                        </td>
                                                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                                                                <a asp-controller="Exam" asp-action="Results" asp-route-studentId="@studentId" asp-route-termId="@term.Id" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-all duration-200 shadow-md group select-button">
                                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus mr-3 group-hover:rotate-90 transition-transform duration-300">
                                                                                                <path d="M12 5v14"/>
                                                                                                <path d="M5 12h14"/>
                                                                                        </svg>
                                                                                        Exam Results </a>
                                                                        </td>
                                                                </tr>
                                                        }
                                                </tbody>
                                        </table>
                                </div>
                        }
                        else{
                                <!-- No Terms Found Message -->
                                <div class="text-center py-16 border-t border-blue-200">
                                        <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                                                <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                </svg>
                                        </div>
                                        <h3 class="text-xl font-semibold text-slate-900 mb-2">No Passed Terms Found</h3>
                                        <p class="text-slate-600 mb-8 max-w-md mx-auto">You have not any academic terms yet.</p>
                                </div>
                        }
                </div>
        </div>
</div>