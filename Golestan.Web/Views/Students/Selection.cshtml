@model TermDto?
@{
        var studentId = (int)ViewBag.studentid;
}
<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- Dashboard Header -->
                <div id="dashboardView" class="animate-fade-in">
                        <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                                <div class="px-8 py-6 border-b border-blue-500">
                                        <div class="flex justify-between items-center">
                                                <div>
                                                        <p class="text-3xl font-bold text-white mb-2">Student Selection</p>
                                                        <p class="text-blue-100 text-lg">Select Available Sections For Term</p>
                                                </div>
                                                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-md">
                                                        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v18H3V3zM3 7h18M3 11h18M3 15h18"></path>
                                                        </svg>
                                                </div>
                                        </div>
                                </div>
                        </div>
                </div>
                @if (Model == null){
                        <div class="mb-8 bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <h3 class="text-lg font-semibold text-blue-800 mb-4">Current Academic Term</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700">
                                        <div>
                                                <strong>Currently There is no active term</strong>
                                        </div>
                                </div>
                        </div>
                }
                else{
                        <div class="mb-8 bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                                <h3 class="text-lg font-semibold text-blue-800 mb-4">Current Term Selection Date Time</h3>
                                <h3 class="text-lg font-semibold text-blue-800 mb-4">Date : @DateTime.UtcNow.ToString("yyyy-M-d dddd")</h3>
                                <h3 class="text-lg font-semibold text-blue-800 mb-4">Term : @Model.TermIdentifier</h3>
                                <h3 class="text-lg font-semibold text-blue-800 mb-4">Selection Period : @Model.SelectionStartTime.ToString("yyyy-M-d dddd") - @Model.SelectionEndTime.ToString("yyyy-M-d dddd")</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700"><br/></div>
                                @if (DateTime.UtcNow > @Model.SelectionEndTime){
                                        <h3 class="text-lg font-semibold text-red-800 mb-4">The Selection Time Passed And No Longer Available</h3>
                                }
                                @if (DateTime.UtcNow < @Model.SelectionStartTime){
                                        <h3 class="text-lg font-semibold text-red-800 mb-4">The Selection Time Not Started Yet</h3>
                                }
                                @if (Model.SelectionStartTime < DateTime.UtcNow && Model.SelectionEndTime > DateTime.UtcNow){
                                        <h3 class="text-lg font-semibold text-green-800 mb-4">The Selection Is Available</h3>
                                }
                        </div>
                }
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        @if (Model != null){
                                <a asp-controller="Students" asp-action="AvailableSections" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                                        <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                                                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                                </svg>
                                        </div>
                                        <h3 class="text-lg font-bold text-white">Available Sections</h3>
                                </a>
                        }
                        @if (Model != null && Model.SelectionStartTime < DateTime.UtcNow && Model.SelectionEndTime > DateTime.UtcNow){
                                <a asp-controller="Selection" asp-action="Index" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                                        <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                                                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 0V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2"></path>
                                                </svg>
                                        </div>
                                        <h3 class="text-lg font-bold text-white">Selection</h3>
                                </a>
                        }

                        @if (Model != null){
                                <a asp-controller="Students" asp-action="Sections" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                                        <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                                                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 0V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2"></path>
                                                </svg>
                                        </div>
                                        <h3 class="text-lg font-bold text-white">My Sections</h3>
                                </a>
                        }
                </div>
        </div>
</div>