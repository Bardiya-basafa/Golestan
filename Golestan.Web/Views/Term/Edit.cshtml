@model TermDto

<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
      <div class="px-8 py-6">
        <h1 class="text-3xl font-bold text-white mb-2">Edit Academic Term</h1>
        <p class="text-blue-100 text-lg">Update details and schedules for the term</p>
      </div>
    </div>
    <!-- Form Container -->
    <div class="bg-white rounded-2xl shadow-lg border border-blue-200 p-8">
      <form asp-controller="Term" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" value="@Model.Id">
        @Html.AntiForgeryToken()
        <div class=" grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Left Column -->
          <div class="space-y-6">
            <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
              <h3 class="text-lg font-bold text-slate-900 mb-4">Term Details</h3>
              <div class="space-y-4">
                <div>
                  <label asp-for="TermIdentifier" class="block text-sm font-bold text-blue-800 mb-2"> Term Identifier </label>
                  <input asp-for="TermIdentifier" placeholder="term identifier like : 2025/3,2026/1" type="text" id="termIdentifier" name="TermIdentifier" value="@Model.TermIdentifier" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900"/>
                </div>
                <div>
                  <label asp-for="TermName" class="block text-sm font-bold text-blue-800 mb-2"> Term Name </label>
                  <input asp-for="TermName" placeholder="term name like : fall 2024, summer 2025" type="text" id="termName" name="TermName" value="@Model.TermName" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900"/>
                </div>
              </div>
            </div>
          </div>
          <!-- Right Column -->
          <div class="space-y-6">
            <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
              <h3 class="text-lg font-bold text-slate-900 mb-4">Examination Period</h3>
              <div class="space-y-4">
                <div>
                  <label for="examsStartTime" asp-for="ExamsStartTime" class="block text-sm font-bold text-blue-800 mb-2"> Exams Start Date </label>
                  <input type="date" asp-for="ExamsStartTime" id="examsStartTime" name="ExamsStartTime" value="@Model.ExamsStartTime.ToString("yyyy-MM-dd")" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
                </div>
                <div>
                  <label for="examsEndTime" asp-for="ExamsEndTime" class="block text-sm font-bold text-blue-800 mb-2"> Exams End Date </label>
                  <input type="date" asp-for="ExamsEndTime" id="examsEndTime" name="ExamsEndTime" value="@Model.ExamsEndTime.ToString("yyyy-MM-dd")" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
                </div>
              </div>
            </div>
            <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
              <h3 class="text-lg font-bold text-slate-900 mb-4">Section Selection Period</h3>
              <div class="space-y-4">
                <div>
                  <label for="SelectionStartTime" asp-for="SelectionStartTime" class="block text-sm font-bold text-blue-800 mb-2"> Registration Opens </label>
                  <input type="date" asp-for="SelectionStartTime" id="SelectionStartTime" name="SelectionStartTime" value="@Model.SelectionStartTime.ToString("yyyy-MM-dd")" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
                </div>
                <div>
                  <label for="SelectionEndTime" asp-for="SelectionEndTime" class="block text-sm font-bold text-blue-800 mb-2"> Registration Closes </label>
                  <input type="date" asp-for="SelectionEndTime" id="SelectionEndTime" name="SelectionEndTime" value="@Model.SelectionEndTime.ToString("yyyy-MM-dd")" required class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Action Buttons -->
        <div class="flex gap-4 mt-8 pt-6 border-t border-blue-200">
          <a asp-controller="Term" asp-action="Index" class="flex-1 py-3 px-6 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold rounded-lg text-center border border-blue-300 transition-colors duration-200"> Cancel </a>
          <button type="submit" class="flex-1 py-3 px-6 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-lg transition-colors duration-200">
            Save Changes
          </button>
        </div>
      </form>
    </div>
    <!-- Back Link -->
    <div class="text-center mt-6">
      <a asp-controller="Admin" asp-action="Index" class="text-blue-800 hover:text-blue-900 font-medium"> Back to Admin Dashboard </a>
    </div>
  </div>
</div>
