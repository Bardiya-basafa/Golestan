@model List<CourseDto>
@{
  var courseId = (int)ViewBag.courseid;
  var courseName = (string)ViewBag.coursename;
}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl w-full space-y-8">
    <!-- Header -->
    <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
      <div class="px-8 py-6 border-b border-blue-500">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-3xl font-bold text-white mb-2">Add Prerequisite to
              <strong class="text-blue-100">@courseName</strong></p>
            <p class="text-blue-100 text-lg">Select a course to add as a prerequisite</p>
          </div>
          <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link-2 text-blue-600 text-3xl">
              <path d="M9 17H7A5 5 0 0 1 7 7h2"/>
              <path d="M15 7h2a5 5 0 0 1 0 10h-2"/>
              <line x1="8" x2="16" y1="12" y2="12"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="px-8 py-6 bg-blue-600">
        <h3 class="text-xl font-semibold text-white">Prerequisite Information</h3>
        <p class="text-blue-100 mt-1">Please select the prerequisite course</p>
      </div>
      <form class="px-8 py-8 space-y-6" asp-controller="Courses" asp-action="SetPrerequisite" method="post">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid){
          <div class="ml-3 bg-red-50 border border-red-200 rounded-xl p-4">
            <h3 class="text-lg font-medium text-red-800">Please correct the following errors:</h3>
            <div class="mt-3 text-sm text-red-700" asp-validation-summary="All"></div>
          </div>
        }
        <input type="hidden" value="@courseId" name="courseId"/>


        <!-- Prerequisite Selection Section -->
        <div class="space-y-6 mt-8">
          <div class="border-l-4 border-blue-500 pl-4">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">Select Prerequisite Course</h4>
          </div>
          <div class="group">
            <label for="prerequisiteCourseId" class="block text-sm font-medium text-gray-700 mb-2"> Prerequisite Course
              <span class="text-red-500">*</span> </label>
            <div class="relative">
              <select name="prerequisiteCourseId" for="prerequisiteCourseId" id="prerequisiteCourseId" class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 group-hover:border-gray-400" required>
                <option value="">-- Select a course --</option>
                @foreach (var course in Model){
                  <option value="@course.Id">@course.CourseName</option>
                } </select>
            </div>
            <p class="text-xs text-gray-500 mt-1">Choose a course that must be completed before this one.</p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-gray-200">
          <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            <span class="flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-5 h-5 mr-2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              Add Prerequisite
            </span>
          </button>
          <button type="reset" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 text-center focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
            <span class="flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw w-5 h-5 mr-2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.76 2.75L3 8"/><path d="M3 3v5h5"/></svg>
              Reset Form
            </span>
          </button>
        </div>
        <!-- Back Link -->
        <div class="text-center pt-4">
          <a asp-controller="Courses" asp-action="Index" asp-route-courseId="@courseId" class="inline-flex items-center text-sm text-blue-600 hover:text-blue-500 transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left w-4 h-4 mr-1 group-hover:-translate-x-1 transition-transform">
              <path d="m12 19-7-7 7-7"/>
              <path d="M19 12H5"/>
            </svg>
            Back to Course Details </a>
        </div>
      </form>
    </div>
  </div>
</div>
