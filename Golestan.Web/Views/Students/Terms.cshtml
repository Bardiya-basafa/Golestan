@model List<TermDto>
@{
    var studentId = ViewBag.StudentId;
}
<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header Section -->
        <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
            <div class="px-8 py-6 border-b border-blue-500">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-3xl font-bold text-white mb-2">My Passed Terms</p>
                        <p class="text-blue-100 text-lg">Review your academic history and completed terms</p>
                    </div>
                    <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-md">
                        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        @await Component.InvokeAsync("StudentInfo", studentId)
        <!-- Current Term Details (Table/Box Style) -->
        @await Component.InvokeAsync("CurrentTerm")
        <!-- Announcement and Notification Boxes (Placeholder for now, as per Admin Dashboard) -->
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Total Passed Terms</p>
                        <p class="text-3xl font-bold text-slate-900">5</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Average Term GPA</p>
                        <p class="text-3xl font-bold text-slate-900">3.5</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 0V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Total Credits Earned</p>
                        <p class="text-3xl font-bold text-slate-900">60</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H2v-2a3 3 0 015.356-1.857M7 20v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857m0 0A7.962 7.962 0 0112 16a7.962 7.962 0 015.356 1.857m-5.356-1.857C10.832 15.477 9.246 15 7.5 15S4.168 15.477 3 16.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 15.477 14.754 15 16.5 15c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-800">Last Term GPA</p>
                        <p class="text-3xl font-bold text-slate-900">3.8</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2zM12 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <!-- Passed Terms Table -->
        <div class="bg-white rounded-lg shadow-sm border border-blue-300 overflow-hidden">
            <div class="px-8 py-6 border-b border-blue-300">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Academic Terms History</h2>
                        <p class="text-slate-600 mt-1">Overview of all terms you have successfully completed</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
                            @Model.Count Completed Terms
                        </span>
                    </div>
                </div>
            </div>
            @if (Model.Count > 0){
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-blue-300">
                        <thead class="bg-blue-50">
                            <tr>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Term ID
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Term Identifier
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Year
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Selection Period
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider border-r border-blue-300">
                                    Exams Period
                                </th>
                                <th scope="col" class="px-8 py-4 text-left text-xs font-bold text-slate-700 uppercase tracking-wider">
                                    Status
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-blue-300">
                            @foreach (var term in Model){
                                <!-- Placeholder Data -->

                                <a asp-controller="Students" asp-action="ExamResults" asp-route-studentId="@studentId" asp-route-termId="@term.Id">
                                    <tr class="hover:bg-blue-50 transition-all duration-200 group">
                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-12 w-12 bg-blue-700 rounded-lg flex items-center justify-center shadow-sm">
                                                    <span class="text-white font-bold text-lg">#@term.Id</span>
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-lg font-bold text-slate-900">Term ID</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                            <div class="text-lg font-bold text-slate-900">@term.TermIdentifier</div>
                                        </td>
                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                            <div class="text-lg font-bold text-slate-900">@term.Year</div>
                                        </td>
                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                            <div class="text-lg font-bold text-slate-900">@term.SelectionStartTime.ToString("yyyy-MM-dd") - @term.SelectionEndTime.ToString("yyyy-MM-dd")</div>
                                        </td>
                                        <td class="px-8 py-6 whitespace-nowrap border-r border-blue-300">
                                            <div class="text-lg font-bold text-slate-900">@term.ExamsStartTime.ToString("yyyy-MM-dd") - @term.ExamsEndTime.ToString("yyyy-MM-dd")</div>
                                        </td>
                                        <td class="px-8 py-6 whitespace-nowrap">
                                            @if (term.IsClosed){
                                                <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-green-100 text-green-800 border border-green-200">
                                                    Finished
                                                </span>
                                            }
                                            else{
                                                <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                                    Active
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                </a>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else{
                <!-- No Terms Found Message -->
                <div class="text-center py-16 border-t border-blue-200">
                    <div class="mx-auto h-24 w-24 bg-white border border-blue-200 rounded-full flex items-center justify-center mb-6">
                        <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-900 mb-2">No Passed Terms Found</h3>
                    <p class="text-slate-600 mb-8 max-w-md mx-auto">You have not completed any academic terms yet.</p>
                </div>
            }
        </div>
        <!-- Student Menu (Card Style with text below and blue icon box) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <a asp-controller="Students" asp-action="Sections" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-white">All Terms Results</h3>
            </a>
            <a asp-controller="Students" asp-action="Schedule" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 0V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-white">Active Term Exams</h3>
            </a>
            <a asp-controller="Students" asp-action="Sections" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-white">My Sections</h3>
            </a>
            <a asp-controller="Students" asp-action="Selection" asp-route-studentId="@studentId" class="bg-blue-600 rounded-lg p-4 shadow-sm border border-blue-700 cursor-pointer group hover:bg-blue-700 transition-colors duration-200 flex flex-col items-center justify-center text-center">
                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center mx-auto mb-4">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v18H3V3zM3 7h18M3 11h18M3 15h18"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-white">Selection</h3>
            </a>
        </div>
    </div>
</div>
