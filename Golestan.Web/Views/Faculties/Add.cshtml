@model Golestan.Application.DTOs.Faculty.AddFacultyDto


<!-- Main Content -->
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
        <div class="px-8 py-6 border-b border-blue-500">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-3xl font-bold text-white mb-2">Add New Faculty</p>
                    <p class="text-blue-100 text-lg">Create a new faculty member record</p>
                </div>
                <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center shadow-md">
                    <i class="fas fa-university text-blue-600 text-3xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg p-8 shadow-sm border border-blue-200 animate-slide-up">
        <form asp-controller="Faculties" asp-action="Add" method="POST" class="space-y-6">
            @Html.AntiForgeryToken()
            <!-- Building name -->
            <div>
                <label asp-for="BuildingName" class="block text-sm font-bold text-slate-700 mb-2">
                    <i class="fas fa-building mr-2 text-blue-700"></i>Building Name *
                </label>
                <input type="text" asp-for="BuildingName" required maxlength="100" class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" placeholder="Enter full building name">
                <span asp-validation-for="BuildingName" class="error-message"></span>
                <p class="text-xs text-slate-500 mt-1">Full building name</p>
            </div>
            <!-- Major -->
            <div>
                <label asp-for="MajorName" class="block text-sm font-bold text-slate-700 mb-2">
                    <i class="fas fa-graduation-cap mr-2 text-blue-700"></i>Major Name *
                </label>
                <input type="text" asp-for="MajorName" required maxlength="100" class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" placeholder="Enter full major name">
                <span asp-validation-for="MajorName" class="error-message"></span>
                <p class="text-xs text-slate-500 mt-1">Full major name</p>
            </div>
            <!-- Budget -->
            <div>
                <label asp-for="Budget" class="block text-sm font-bold text-slate-700 mb-2">
                    <i class="fas fa-dollar-sign mr-2 text-blue-700"></i>Budget Amount *
                </label>
                <input type="number" asp-for="Budget" required min="1" class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" placeholder="Enter budget amount (e.g., 12345)">
                <span asp-validation-for="Budget" class="error-message"></span>
                <p class="text-xs text-slate-500 mt-1">Official university budget</p>
            </div>
            <!-- Start Date -->
            <div>
                <label asp-for="StartDate" class="block text-sm font-bold text-slate-700 mb-2">
                    <i class="fas fa-calendar-alt mr-2 text-blue-700"></i>Establishment Date *
                </label>
                <input type="date" asp-for="StartDate" required class="w-full p-4 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200">
                <p class="text-xs text-slate-500 mt-1">Date when the faculty was established</p>
            </div>
            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-blue-200">
                <button type="reset" class="flex-1 bg-white text-slate-700 py-4 px-6 rounded-lg hover:bg-blue-50 transition-all duration-200 font-semibold border border-blue-200 shadow-sm">
                    <i class="fas fa-undo mr-2"></i>Reset Form
                </button>
                <button type="submit" class="flex-1 bg-blue-600 text-white py-4 px-6 rounded-lg hover:bg-blue-700 transition-all duration-200 font-semibold shadow-md">
                    <i class="fas fa-plus mr-2"></i>Add Faculty
                </button>
            </div>
        </form>
    </div>
    <!-- Form Information -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
        <div class="flex items-start">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-4 mt-1">
                <i class="fas fa-info text-white text-sm"></i>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-blue-800 mb-2">Form Guidelines</h3>
                <ul class="text-blue-700 space-y-1 text-sm">
                    <li><strong>Building Name:</strong> Must be unique and descriptive.</li>
                    <li><strong>Major Name:</strong> Must be unique and descriptive.</li>
                    <li><strong>Budget Amount:</strong> Enter the allocated budget for the faculty.</li>
                    <li><strong>Establishment Date:</strong> The date when the faculty was officially established.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
