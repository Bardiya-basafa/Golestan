@model TermDto?

@if (Model == null){
        <div class="mb-8 bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <h3 class="text-lg font-semibold text-blue-800 mb-4">Current Academic Term</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700">
                        <div>
                                <strong>Currently There is no active term</strong>
                        </div>
                </div>
        </div>
}
else{
        <div class="mb-8 bg-white rounded-lg p-6 shadow-sm border border-blue-200">
                <h3 class="text-lg font-semibold text-blue-800 mb-4">Current Academic Term</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700">
                        <div>
                                <strong>Term :</strong> @Model.TermIdentifier,
                        </div>
                        <div>
                                <strong>Year :</strong> @Model.Year,
                        </div>
                        <div>
                                <strong>Start Date:</strong> September 1, 2025
                        </div>
                        <div>
                                <strong>Exams Period:</strong> @Model.ExamsStartTime.ToString("yyyy-M-d dddd") - @Model.ExamsEndTime.ToString("yyyy-M-d dddd")
                        </div>
                        <div>
                                <strong>Selection Period:</strong> @Model.SelectionStartTime.ToString("yyyy-M-d dddd") - @Model.SelectionEndTime.ToString("yyyy-M-d dddd")
                        </div>
                        <div>
                                <strong>Current Date Time:</strong> @DateTime.UtcNow.ToString("yyyy-M-d dddd")
                        </div>
                        <div>
                                <strong>Status:  </strong> @(Model.IsClosed ? "Completed" : "Active")
                        </div>
                </div>
        </div>
}