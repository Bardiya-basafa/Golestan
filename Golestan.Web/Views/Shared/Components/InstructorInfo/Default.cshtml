@model InstructorDto

<div class="mb-8 bg-white rounded-lg p-6 shadow-sm border border-blue-200">
        <h3 class="text-xl font-bold text-black mb-4">Instructor Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700">
                <div>
                        <strong>Full Name :</strong> @Model.FullName
                </div>
                <div>
                        <strong>Hire Date :</strong> @Model.HireDate.ToString("yyyy-M-d dddd")
                </div>
                <div>
                        <strong>Salary Date:</strong> @Model.Salary
                </div>
                <div>
                        <strong>Instructor Number:</strong> @(Model.InstructorNumber ?? "N/A")
                </div>
                <div>
                        <strong>Total Sections Period:</strong> @Model.Sections.Count
                </div>
        </div>
</div>