@model AddStudentToSectionDto
@{
    ViewData["Title"] = "Add Students to Section";
    int sectionId = ViewBag.SectionId;
    string courseName = ViewBag.CourseName;
    int remainCapacity = ViewBag.RemainCapacity;
    int classCapacity = ViewBag.ClassCapacity;
}

<div class="bg-gradient-to-br from-white via-blue-50 to-blue-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Header Section -->
        <div class="mb-8 animate-fade-in">
            <div class="bg-blue-600 rounded-lg shadow-sm border border-blue-700 mb-8 overflow-hidden">
                <div class="px-8 py-6 border-b border-blue-500">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                        <div class="mb-6 lg:mb-0">
                            <div class="flex items-center mb-4">
                                <div class="w-16 h-16 bg-blue-700 rounded-lg flex items-center justify-center shadow-md mr-6">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus text-white text-2xl">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <line x1="19" x2="19" y1="8" y2="14" />
                                        <line x1="22" x2="16" y1="11" y2="11" />
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-3xl font-bold text-white mb-2">Add Students to Section</h2>
                                    <p class="text-blue-100 text-lg font-medium">@courseName - Section #@sectionId - Classroom capacity: @classCapacity</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex space-x-4">
                            <a href="javascript:history.back()" class="flex items-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl transition-all duration-200 shadow-lg border border-gray-200 font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left mr-2">
                                    <path d="m12 19-7-7 7-7" />
                                    <path d="M19 12H5" />
                                </svg>
                                Back to Section
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column - Search and Instructions -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 p-6 mb-6 animate-fade-in">
                    <h3 class="text-xl font-bold text-blue-800 mb-4">Search Students</h3>
                    <div class="mb-6">
                        <label for="studentSearch" class="block text-sm font-medium text-gray-700 mb-2">Search by Student Number</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 right-2 pl-3 flex items-center pointer-events-none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-gray-400">
                                    <circle cx="11" cy="11" r="8" />
                                    <path d="m21 21-4.3-4.3" />
                                </svg>
                            </div>
                            <input type="text" id="studentSearch" placeholder="Enter student number or name..." class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200">
                        </div>
                    </div>
                    <div class="bg-blue-50 rounded-lg p-4 border border-blue-100 mb-4">
                        <h2 class="font-bold text-blue-800 flex items-center mb-2">
                            Remain Capacity:
                            <span id="remain-capacity" class="font-bold ml-2">@remainCapacity</span>
                        </h2>
                        <div id="max-capacity" class="text-sm mt-2">
                            <!-- Capacity message will appear here -->
                        </div>
                    </div>
                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="font-bold text-gray-700">Selected Students</h4>
                            <span id="selectedCount" class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-1 rounded-full">0</span>
                        </div>
                        <div id="selectedStudentsList" class="bg-gray-50 rounded-lg p-4 border border-gray-200 min-h-[100px] max-h-[200px] overflow-y-auto">
                            <p id="noSelectionMessage" class="text-gray-500 text-sm text-center py-4">No students selected</p>
                        </div>
                    </div>
                    <div>
                        <form id="addStudentsForm" method="post" asp-controller="Sections" asp-action="SetStudents">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sectionId" value="@sectionId">
                            <div id="selectedStudentsInputs"></div>
                            <button type="submit" id="submitButton" disabled class="w-full py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-all duration-200 shadow-lg font-medium disabled:opacity-50 disabled:cursor-not-allowed">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus mr-2">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <line x1="19" x2="19" y1="8" y2="14" />
                                    <line x1="22" x2="16" y1="11" y2="11" />
                                </svg>
                                Add Selected Students
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Right Column - Students List -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-sm border border-blue-200 overflow-hidden animate-fade-in">
                    <div class="bg-blue-600 p-6">
                        <div class="flex justify-between items-center">
                            <div>
                                <h3 class="text-2xl font-bold text-white">Available Students</h3>
                                <p class="text-blue-100">Select students to add to this section</p>
                            </div>
                            <div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white/20 backdrop-blur-sm text-white">
                                    @Model.Students.Count Students
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="p-6">
                        @if (Model.Students != null && Model.Students.Count > 0){
                        <div class="overflow-x-auto">
                            <table class="min-w-full">
                                <thead>
                                    <tr class="border-b-2 border-blue-200">
                                        <th class="text-left py-4 px-6 font-bold text-gray-700 uppercase tracking-wider w-12">
                                            <input type="checkbox" id="selectAll" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                        </th>
                                        <th class="text-left py-4 px-6 font-bold text-gray-700 uppercase tracking-wider">
                                            Student
                                        </th>
                                        <th class="text-left py-4 px-6 font-bold text-gray-700 uppercase tracking-wider">
                                            Student Number
                                        </th>
                                        <th class="text-left py-4 px-6 font-bold text-gray-700 uppercase tracking-wider">
                                            Email
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="studentsTableBody" class="divide-y divide-gray-100">
                                    @foreach (var student in Model.Students){
                                    <tr class="student-row transition-all duration-200" data-student-id="@student.Id" data-student-number="@student.StudentNumber" data-student-name="@student.FullName">
                                        <td class="py-4 px-6">
                                            <input type="checkbox" name="selectedStudents" value="@student.Id" class="student-checkbox w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                        </td>
                                        <td class="py-4 px-6">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-12 w-12 bg-blue-100 rounded-xl flex items-center justify-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap text-blue-600 text-xl">
                                                        <path d="M21.43 12.79V2.5L12.01 7.5 2.57 2.5V12.79" />
                                                        <path d="M2.57 17.5V22.5L12.01 17.5 21.43 22.5V17.5" />
                                                        <path d="M12.01 7.5V17.5" />
                                                    </svg>
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-base font-bold text-gray-800">@student.FullName</div>
                                                    <div class="text-xs text-gray-500">ID: @student.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-6">
                                            <div class="text-base font-medium text-gray-800">@student.StudentNumber</div>
                                        </td>
                                        <td class="py-4 px-6">
                                            <div class="text-sm text-gray-600">@student.Email</div>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        }
                        <!-- This div will be toggled by JS for search results -->
                        <div id="studentsEmptyState" class="text-center py-12 @(Model.Students != null && Model.Students.Count > 0 ? "hidden" : "")">
                            <div class="w-24 h-24 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-blue-400 text-3xl">
                                    <circle cx="11" cy="11" r="8" />
                                    <path d="m21 21-4.3-4.3" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-gray-700 mb-2">No Students Found</h3>
                            <p class="text-gray-500 text-base mb-4 max-w-md mx-auto">No students match your search criteria.</p>
                            <button type="button" id="clearSearchBtn" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg transition-all duration-200 font-medium">
                                Clear Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Back Navigation -->
        <div class="mt-12 text-center">
            <a asp-controller="Sections" asp-action="Index" asp-route-sectionId="@sectionId" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors group font-semibold text-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left mr-3 group-hover:-translate-x-1 transition-transform">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                Back to Section
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const studentSearch = document.getElementById('studentSearch');
        const studentsTableBody = document.getElementById('studentsTableBody');
        const studentRows = document.querySelectorAll('.student-row');
        const studentsEmptyState = document.getElementById('studentsEmptyState'); // Corrected ID
        const clearSearchBtn = document.getElementById('clearSearchBtn');
        const selectAll = document.getElementById('selectAll');
        const selectedStudentsList = document.getElementById('selectedStudentsList');
        const noSelectionMessage = document.getElementById('noSelectionMessage');
        const selectedCount = document.getElementById('selectedCount');
        const submitButton = document.getElementById('submitButton');
        const selectedStudentsInputs = document.getElementById('selectedStudentsInputs');

        let remainCapacity = @remainCapacity; // Initialized from Razor variable

        // Initial update of capacity display
        updateCapacityDisplay();
        updateSelectedStudents(); // To ensure initial state is correct

        // Search functionality
        studentSearch.addEventListener('input', function () {
            const searchValue = this.value.toLowerCase().trim();
            let visibleCount = 0;

            studentRows.forEach(row => {
                const studentNumber = row.getAttribute('data-student-number').toLowerCase();
                const studentName = row.getAttribute('data-student-name').toLowerCase();

                if (studentNumber.includes(searchValue) || studentName.includes(searchValue)) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            // Show/hide empty state based on search results
            if (visibleCount === 0) {
                studentsEmptyState.classList.remove('hidden');
            } else {
                studentsEmptyState.classList.add('hidden');
            }
        });

        // Clear search
        clearSearchBtn.addEventListener('click', function () {
            studentSearch.value = '';
            studentRows.forEach(row => row.classList.remove('hidden'));
            studentsEmptyState.classList.add('hidden');
        });

        // Select all functionality with capacity check
        selectAll.addEventListener('change', function () {
            const isChecked = this.checked;
            const visibleStudentRows = Array.from(studentRows).filter(row => !row.classList.contains('hidden'));

            if (isChecked) {
                let selectedCountThisPass = 0;
                visibleStudentRows.forEach(row => {
                    const checkbox = row.querySelector('.student-checkbox');
                    if (checkbox && !checkbox.checked && !checkbox.disabled && remainCapacity > 0) {
                        checkbox.checked = true;
                        row.classList.add('selected');
                        remainCapacity--;
                        selectedCountThisPass++;
                    }
                });
                // If not all visible students could be selected due to capacity, uncheck selectAll
                const currentlySelectedVisible = Array.from(studentsTableBody.querySelectorAll('.student-row:not(.hidden) .student-checkbox:checked')).length;
                const totalVisible = Array.from(studentsTableBody.querySelectorAll('.student-row:not(.hidden)')).length;
                if (currentlySelectedVisible < totalVisible) {
                    this.checked = false; // Cannot select all visible due to capacity
                }
            } else {
                visibleStudentRows.forEach(row => {
                    const checkbox = row.querySelector('.student-checkbox');
                    if (checkbox && checkbox.checked) {
                        checkbox.checked = false;
                        row.classList.remove('selected');
                        remainCapacity++;
                    }
                });
            }
            updateCapacityDisplay();
            updateSelectedStudents();
        });

        // Individual checkbox functionality with capacity check
        document.querySelectorAll('.student-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                const row = this.closest('.student-row');
                if (this.checked) {
                    if (remainCapacity > 0) {
                        remainCapacity--;
                        row.classList.add('selected');
                    } else {
                        this.checked = false; // Prevent selection if no capacity
                        // Optional: Add a temporary visual feedback here
                        return;
                    }
                } else {
                    remainCapacity++;
                    row.classList.remove('selected');
                }
                updateCapacityDisplay();
                updateSelectedStudents();
            });
        });

        // Update capacity display
        function updateCapacityDisplay() {
            document.getElementById('remain-capacity').innerHTML = remainCapacity;
            const maxCapacityDiv = document.getElementById('max-capacity');
            if (remainCapacity === 0) {
                maxCapacityDiv.innerHTML = `<span class="text-red-600 font-medium">Class capacity reached - cannot select more students</span>`;
                disableUncheckedCheckboxes();
            } else {
                maxCapacityDiv.innerHTML = "";
                enableAllCheckboxes(); // Re-enable if capacity becomes available
            }
        }

        // Disable unchecked checkboxes when capacity is reached
        function disableUncheckedCheckboxes() {
            document.querySelectorAll('.student-checkbox:not(:checked)').forEach(checkbox => {
                checkbox.disabled = true;
                checkbox.closest('.student-row').classList.add('disabled-row');
            });
        }

        // Enable all checkboxes
        function enableAllCheckboxes() {
            document.querySelectorAll('.student-checkbox').forEach(checkbox => {
                checkbox.disabled = false;
                checkbox.closest('.student-row').classList.remove('disabled-row');
            });
        }

        // Update selected students list and hidden inputs for form submission
        function updateSelectedStudents() {
            const selectedCheckboxes = document.querySelectorAll('.student-checkbox:checked');
            selectedCount.textContent = selectedCheckboxes.length;

            // Clear previous selections
            selectedStudentsList.innerHTML = '';
            selectedStudentsInputs.innerHTML = '';

            if (selectedCheckboxes.length === 0) {
                selectedStudentsList.appendChild(noSelectionMessage);
                submitButton.disabled = true;
                selectAll.checked = false; // Deselect "select all" if no students are selected
            } else {
                submitButton.disabled = false;
                selectedCheckboxes.forEach((checkbox) => {
                    const row = checkbox.closest('.student-row');
                    const studentId = row.getAttribute('data-student-id');
                    const studentName = row.getAttribute('data-student-name');
                    const studentNumber = row.getAttribute('data-student-number');

                    // Create selected student item
                    const studentItem = document.createElement('div');
                    studentItem.className = 'flex items-center justify-between py-2 border-b border-slate-100 last:border-0';
                    studentItem.innerHTML = `
                        <div class="flex items-center">
                            <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center mr-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user text-indigo-600 text-sm">
                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <div>
                                <div class="text-sm font-medium text-slate-800">${studentName}</div>
                                <div class="text-xs text-slate-500">${studentNumber}</div>
                            </div>
                        </div>
                        <button type="button" class="remove-student text-slate-400 hover:text-red-500 transition-colors" data-student-id="${studentId}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4">
                                <path d="M18 6 6 18"/>
                                <path d="m6 6 12 12"/>
                            </svg>
                        </button>
                    `;
                    selectedStudentsList.appendChild(studentItem);

                    // Create hidden input for form submission
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'StudentIds'; // Same name for all
                    hiddenInput.value = studentId;
                    selectedStudentsInputs.appendChild(hiddenInput);
                });
            }
        }

        // Event delegation for remove buttons in selectedStudentsList
        selectedStudentsList.addEventListener('click', function(event) {
            const removeButton = event.target.closest('.remove-student');
            if (removeButton) {
                const studentId = removeButton.getAttribute('data-student-id');
                const checkbox = document.querySelector(`.student-checkbox[value="${studentId}"]`);
                if (checkbox) {
                    checkbox.checked = false;
                    // Manually trigger change event to update capacity and lists
                    const changeEvent = new Event('change');
                    checkbox.dispatchEvent(changeEvent);
                }
            }
        });
    });
</script>
